{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.mjs",
    "src/app/**/{page,layout,route}.tsx",
    "src/app/**/route.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "src/server/domain/model.ts",
    "src/server/domain/sources.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ]
}
