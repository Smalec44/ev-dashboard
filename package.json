{
  "name": "ev-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "knip",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run analyze && npm test",
    "test": "TZ=Europe/Zurich node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/resolve-alias.mjs --test",
    "build:data": "node --import ./scripts/resolve-alias.mjs scripts/build-data.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "knip": "^6.35.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  }
}
